# Generate .env with: python scripts/init-env.py
# Never commit .env. Demo mode needs no .env file.
DATABASE_PASSWORD=replace-with-generated-value
REDIS_PASSWORD=replace-with-generated-value
ADMIN_PASSWORD=replace-with-generated-value
VIEWER_PASSWORD=replace-with-generated-value
WORKER_PASSWORD=replace-with-generated-value
GRAFANA_PASSWORD=replace-with-generated-value
SEED_DEMO=true
# Optional: explicitly configure a trusted OpenAI-compatible endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
